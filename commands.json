{
  "title": "花輪同學 - tzukitbot的指令表",
  "prefix": "!",
  "groups": [
    {
      "name": "頻道管理",
      "commands": [
        {
          "name": "t",
          "usage": "!t <標題>",
          "description": "設定頻道標題",
          "permission": "管理員以上",
          "cooldown": "全頻道 1 秒",
          "aliases": []
        },
        {
          "name": "g",
          "usage": "!g <分類>",
          "description": "設定頻道分類／遊戲",
          "permission": "管理員以上",
          "cooldown": "全頻道 1 秒",
          "aliases": []
        },
        {
          "name": "adduser",
          "usage": "!adduser <Twitch ID>",
          "description": "新增或移除授權預測指令名單使用者",
          "permission": "管理員以上",
          "cooldown": "",
          "aliases": []
        },
        {
          "name": "removeuser",
          "usage": "!removeuser <Twitch ID>",
          "description": "移除授權預測指令名單使用者",
          "permission": "管理員以上",
          "cooldown": "",
          "aliases": []
        }
      ]
    },
    {
      "name": "預測",
      "commands": [
        {
          "name": "create_prediction",
          "usage": "!開盤 <預測標題> <選項1> <選項2> [...選項8] <秒數>",
          "description": "建立預測，最少 2 個，最多 8 個選項，秒數 30-1800 秒",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["開盤", "startpred"]
        },
        {
          "name": "end_prediction",
          "usage": "!結盤 <選項名稱>",
          "description": "結算預測",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["結盤", "endpred"]
        },
        {
          "name": "lock_prediction",
          "usage": "!關盤 [多少秒後關閉]",
          "description": "鎖定預測，可選擇多少秒後關閉（預設 10 秒）",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["關盤", "鎖盤", "lockpred"]
        },
        {
          "name": "cancel_prediction",
          "usage": "!退盤",
          "description": "取消預測並退還點數",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["退盤", "cancelpred"]
        }
      ]
    },
    {
      "name": "游戲戰績查詢",
      "commands": [
        {
          "name": "rank",
          "description": "各遊戲段位指令總覽（TFT／韓服 LOL／VALORANT）",
          "permission": "所有觀眾",
          "cooldown": "",
          "aliases": ["r"]
        },
        {
          "name": "tftrank",
          "usage": "!tftrank",
          "description": "查詢主播的 TFT 戰績",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": ["tftr"]
        },
        {
          "name": "krrank",
          "usage": "!kr",
          "description": "查詢 韓服英雄聯盟 戰績",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": ["kr", "krr"]
        },
        {
          "name": "valrank",
          "usage": "!valrank",
          "description": "查詢 VALORANT 戰績",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": ["valr", "vr"]
        }
      ]
    },
    {
      "name": "實用指令",
      "commands": [
        {
          "name": "viewer_count",
          "usage": "!守靈",
          "description": "查詢聊天室目前人數",
          "permission": "所有觀眾",
          "cooldown": "僅限離綫時使用",
          "aliases": []
        },
        {
          "name": "song",
          "usage": "!song",
          "description": "顯示目前播放的 Spotify 歌曲",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": ["music", "音樂", "spotify"]
        },
        {
          "name": "selftimeout",
          "usage": "!600",
          "description": "自願被禁言 60 秒",
          "permission": "所有觀眾",
          "cooldown": "每人 1 秒",
          "aliases": ["600", "60", "6oo", "6o0", "6OO", "60o", "6oO", "6Oo"]
        },
        {
          "name": "listcmd",
          "usage": "!listcmd",
          "description": "列出所有自訂指令",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": []
        },
        {
          "name": "listuser",
          "usage": "!listuser",
          "description": "列出所有授權使用者",
          "permission": "所有觀眾",
          "cooldown": "全頻道 3 秒",
          "aliases": []
        }
      ]
    },
    {
      "name": "自訂指令管理",
      "commands": [
        {
          "name": "addcmd",
          "usage": "!addcmd <指令名稱> <回覆訊息>",
          "description": "新增自訂指令",
          "permission": "管理員以上",
          "cooldown": "",
          "aliases": []
        },
        {
          "name": "removecmd",
          "usage": "!removecmd <指令名稱>",
          "description": "刪除自訂指令",
          "permission": "管理員以上",
          "cooldown": "",
          "aliases": []
        },
        {
          "name": "editcmd",
          "usage": "!editcmd <指令名稱> <回覆訊息>",
          "description": "編輯自訂指令",
          "permission": "管理員以上",
          "cooldown": "",
          "aliases": []
        }
      ]
    },
    {
      "name": "有趣的指令",
      "commands": [
        {
          "name": "fate",
          "usage": "!運勢",
          "description": "抽一張塔羅牌占卜",
          "permission": "所有觀眾",
          "cooldown": "每人一天一次・每日 00:00 重置",
          "aliases": ["fate"]
        }
      ]
    }
  ]
}
