{
  "title": "我的指令表",
  "prefix": "!",
  "groups": [
    {
      "name": "頻道管理",
      "commands": [
        {
          "name": "t",
          "usage": "!t <new_title>",
          "description": "設定頻道標題",
          "permission": "管理員以上",
          "cooldown": "全頻道 1 秒",
          "aliases": []
        },
        {
          "name": "g",
          "usage": "!g <new_category>",
          "description": "設定頻道分類／遊戲",
          "permission": "管理員以上",
          "cooldown": "全頻道 1 秒",
          "aliases": []
        }
      ]
    },
    {
      "name": "預測",
      "commands": [
        {
          "name": "adduser",
          "usage": "!adduser <username>",
          "description": "新增或移除授權名單使用者",
          "permission": "管理員以上・授權名單",
          "cooldown": "",
          "aliases": []
        },
        {
          "name": "removeuser",
          "usage": "!removeuser <username>",
          "description": "移除授權名單使用者",
          "permission": "管理員以上・授權名單",
          "cooldown": "",
          "aliases": []
        },
        {
          "name": "create_prediction",
          "usage": "!開盤 <title> <outcome1> <outcome2> [...outcome8] <time_seconds>",
          "description": "建立 Twitch 頻道預測（開盤）",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["開盤", "startpred"]
        },
        {
          "name": "end_prediction",
          "usage": "!結盤 <outcome_name>",
          "description": "以獲勝選項結算預測（結盤）",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["結盤", "endpred"]
        },
        {
          "name": "lock_prediction",
          "usage": "!關盤 <seconds>",
          "description": "鎖定預測、停止接受下注（關盤）",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["關盤", "鎖盤", "lockpred"]
        },
        {
          "name": "cancel_prediction",
          "usage": "!退盤",
          "description": "取消預測並全數退還點數（退盤）",
          "permission": "管理員以上・授權名單",
          "cooldown": "全頻道 1 秒",
          "aliases": ["退盤", "cancelpred"]
        }
      ]
    },
    {
